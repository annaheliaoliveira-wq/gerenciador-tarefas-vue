<%- include('partials/header') %>

<div class="card login-card">
  <h1>Acesso ao Sistema</h1>
  <p>Informe suas credenciais para gerenciar suas tarefas.</p>

  <% if (erro) { %>
    <div class="alert-danger">
      <%= erro %>
    </div>
  <% } %>

  <form action="/login" method="POST">
    <div class="form-group">
      <label for="email">E-mail:</label>
      <input type="email" id="email" name="email" placeholder="exemplo@teste.com" required autofocus>
    </div>

    <div class="form-group">
      <label for="senha">Senha:</label>
      <input type="password" id="senha" name="senha" placeholder="Sua senha" required>
    </div>

    <button type="submit" class="btn btn-block">Entrar</button>
  </form>

  <div class="login-hint">
    <h3>Usuários de Teste para Avaliação:</h3>
    <div class="test-user-box">
      <strong>Administrador:</strong>
      <code>admin@teste.com</code> / <code>admin123</code>
      <span class="badge badge-admin">admin</span>
    </div>
    <div class="test-user-box">
      <strong>Usuário Comum:</strong>
      <code>user@teste.com</code> / <code>user123</code>
      <span class="badge badge-user">user</span>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
